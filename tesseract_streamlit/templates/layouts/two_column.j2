{% import "templates/macros.j2" as m with context %}
{#- two-column layout: inputs and outputs sit side-by-side. each column is
    wrapped in a fixed-height container so they scroll independently: the user
    can keep tweaking inputs and watching results side-by-side without scrolling
    the whole page. the submit button sits at the top of the input column,
    keeping it always visible for interactive use.
    args:
        schema: the schema for the Streamlit form
    outputs: interactive streamlit form code
-#}
{% macro insert_form(schema, udfs) %}
{# Each column lives in a scrollable st.container. Streamlit only turns a
   container into a scroll region when it has a fixed `height`, so we set a
   fallback pixel height and then override it with CSS so the columns instead
   stretch to fill the viewport below the page header.

   The `key` gives each container a stable `.st-key-<key>` class. That element
   itself is `flex: 1 1 0%`, so its height is dictated by its parent's
   `flex-basis` (which Streamlit sets to the fixed pixel height). We therefore
   target the *parent* via `:has()` and relax its basis to a viewport-relative
   value; the keyed element then stretches to fill it and scrolls internally. #}
_COLUMN_FALLBACK_HEIGHT = 800
st.html(
    '''
    <style>
    /* Pin the whole app to the viewport so only the columns scroll, never the
       page body. Streamlit's main region (stMain) scrolls by default once the
       title + the tall default block padding push content past the viewport. */
    [data-testid="stMain"] {
        overflow: hidden !important;
    }
    /* Trim Streamlit's generous default block padding (~6rem top / 10rem
       bottom) so the title sits compactly above the columns. */
    [data-testid="stMainBlockContainer"] {
        padding-top: 2rem !important;
        padding-bottom: 1rem !important;
    }
    /* Cap the header (title + description) at a fixed height and let it scroll
       internally if the description is long. This keeps the space above the
       columns deterministic regardless of description length, so the 12rem
       budget in the column height calc below holds instead of being a guess
       that a long description would blow past. The cap lives *inside* that
       budget, so it doesn't shorten the columns. */
    .st-key-app_header {
        max-height: 10rem;
        overflow-y: auto;
    }
    /* Make the columns row fill the height left below the (now capped) header,
       and have each scroll column stretch to fill that row. The keyed element
       is a flex child (`flex: 1 1 0%`) sized by its parent's flex-basis, so we
       target the parent via `:has()`. The 12rem budget covers the trimmed block
       padding plus the header; capping the header above keeps that budget valid
       regardless of how long the description is. */
    div:has(> .st-key-io_col_input),
    div:has(> .st-key-io_col_output) {
        --io-col-height: calc(100vh - 12rem);
        flex: 1 1 var(--io-col-height) !important;
        height: var(--io-col-height) !important;
    }
    </style>
    '''
)

input_col, output_col = st.columns([2, 3])

with input_col.container(height=_COLUMN_FALLBACK_HEIGHT, key="io_col_input"):
    with st.form("tesseract_form", border=False):
        {{ m.render_fields(schema) | indent(8) }}
        {# reserve a slot for validation errors just above the submit button so
           they stay in view; the page body is `overflow: hidden`, so a banner
           rendered below the columns would be clipped and easy to miss. #}
        error_slot = st.empty()
        submitted = st.form_submit_button("Submit", use_container_width=True)

if submitted:
    {{ m.required_field_guard(schema, "error_slot") | indent(4) }}
    if not _missing_names:
        with output_col.container(
            height=_COLUMN_FALLBACK_HEIGHT, key="io_col_output"
        ):
            {{ m.render_outputs(schema, udfs) | indent(12) }}
{% endmacro %}
